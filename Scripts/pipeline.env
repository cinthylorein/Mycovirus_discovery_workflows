#!/usr/bin/env bash
# Central config for Mycovirus_discovery_workflows (portable across Slurm clusters)
# Edit PIPELINE_ROOT (and optionally PROJECT) to match your environment.

# 1) REQUIRED: where the project folder lives (user chooses)
# NOTE: avoid overriding the system USER unless you really want to.
export USER="${USER:-hraczj}"
export PIPELINE_ROOT="${PIPELINE_ROOT:-/workspace/${USER}/Mycovirus_discovery_workflows}"

# 2) REQUIRED: the project folder name inside PIPELINE_ROOT
export PROJECT="${PROJECT:-MVoP_pipeline}"

# 3) Optional: scratch/temp location (falls back safely)
# Priority: SCRATCH_ROOT (pre-set) > SLURM_TMPDIR > project tmp
export SCRATCH_ROOT="${SCRATCH_ROOT:-${SLURM_TMPDIR:-${PIPELINE_ROOT}/${PROJECT}/tmp}}"

# ---- Derived paths (do not edit) ----
export PROJECT_DIR="${PIPELINE_ROOT}/${PROJECT}"

export SCRIPTS_DIR="${PROJECT_DIR}/Scripts"
export CONFIG_DIR="${PROJECT_DIR}/config"

export LOG_DIR="${PROJECT_DIR}/logs"
export ACCESSION_DIR="${PROJECT_DIR}/accession_lists"
export ADAPTER_DIR="${PROJECT_DIR}/adapters"

export RAW_DIR="${PROJECT_DIR}/raw_reads"
# create a copy of your libraries here: cp -a /source/folder/. "$RAW_DIR"/

export FASTQC_DIR="${PROJECT_DIR}/fastqc"
export TRIM_DIR="${PROJECT_DIR}/trimmed_reads"
export CONTIGS_DIR="${PROJECT_DIR}/contigs"
export MAPPING_DIR="${PROJECT_DIR}/mapping"
export BLAST_DIR="${PROJECT_DIR}/blast_results"

# Main pipeline output directory
# Override by exporting OUTDIR before sourcing this file if you want a custom location.
export OUTDIR="${OUTDIR:-${PROJECT_DIR}/results}"

# Annotation/orf/phylo results live here (default points inside the project)
# Override by exporting ANNOTATION_DIR before sourcing this file if desired.
export ANNOTATION_DIR="${ANNOTATION_DIR:-${PROJECT_DIR}/annotation}"

# Convenience: ensure essential dirs exist when sourced
mkdir -p \
  "${LOG_DIR}" \
  "${ACCESSION_DIR}" \
  "${RAW_DIR}" \
  "${OUTDIR}" \
  "${ANNOTATION_DIR}" \
  "${SCRATCH_ROOT}"

# ----------------------------
# Output layout
# ----------------------------
export GM_OUT_SUBDIR="${GM_OUT_SUBDIR:-genemark}"
export GM_PROTEINS_BASENAME="${GM_PROTEINS_BASENAME:-proteins.faa}"
export GM_NUCS_BASENAME="${GM_NUCS_BASENAME:-proteins.fna}"      # optional
export GM_GFF_BASENAME="${GM_GFF_BASENAME:-genemark.gff}"        # optional

# Build the proteins path consistently as:
# ${ANNOTATION_DIR}/orf_and_phylo/${SAMPLE}/${GM_OUT_SUBDIR}/${GM_PROTEINS_BASENAME}
#
# Some scripts may instead use OUTDIR as the base; provide a safe default for that case:
export PROTEINS_FAA_DEFAULT="${OUTDIR}/${GM_OUT_SUBDIR}/${GM_PROTEINS_BASENAME}"
export PROTEINS_FAA="${PROTEINS_FAA:-${PROTEINS_FAA_DEFAULT}}"

# ------------------------------
# Cluster-specific reference genome path
# (override via env if needed) for bowtie2 step
# ------------------------------
# FIXED: use ${VAR:-default}, not ${VAR:"default"}
export REF="${REF:-/input/genomic/viral/Botrytis_cinerea_Refseq/Botrytiscinerea_RefSeq_B0510_ASM14353v4.fasta}"

# ----------------------------
# References
# ----------------------------
# Folder with family reference FASTAs/alignments
export REF_ALIGNMENTS_DIR="${REF_ALIGNMENTS_DIR:-${PROJECT_DIR}/reference_alignments}"
export STEP9_OUT_SUBDIR="${STEP9_OUT_SUBDIR:-step9}"

# ----------------------------
# Notifications / misc
# ----------------------------
export EMAIL="${EMAIL:-mvop.mycoviromeonline@gmail.com}"

# ----------------------------
# Dependencies
# ----------------------------
export TRIMMOMATIC_JAR="${TRIMMOMATIC_JAR:-/software/bioinformatics/trimmomatic-0.39/trimmomatic-0.39.jar}"
export CLIP="${CLIP:-${ADAPTER_DIR}/Illumina.fa}"
export DIAMOND_BIN="${DIAMOND_BIN:-/workspace/hraczj/Virus_discovery_workflows_09_03_2026/diamond}"

# ----------------------------
# Databases
# ----------------------------
export BLASTDB_NT="${BLASTDB_NT:-/input/genomic/viral/DBs/NCBI_NonHumanViral_nt_May2025}"
export BLASTDB_NR="${BLASTDB_NR:-/input/genomic/viral/DBs/NCBI_NonHumanViral_nr_May2025/NCBI_NonHuman_ViralSequences_nr_May2025}"
export DIAMONDDB_RDRP="${DIAMONDDB_RDRP:-/input/genomic/viral/DBs/RdRp-scan/RdRp-scan_0.90.dmnd}"

# Per-database result folders
export LOG_NT="${BLAST_DIR}/nt"
export LOG_TX="${BLAST_DIR}/tx"
export LOG_RDRP="${BLAST_DIR}/rdrp"
mkdir -p "${LOG_NT}" "${LOG_TX}" "${LOG_RDRP}"

# Metadata tables
export BLASTDB_NT_METADATA="/input/genomic/viral/DBs/NCBI_NonHumanViral_nt_May2025/Metadata_NCBI_NonHumanViral_nt_May2025.csv"
export BLASTDB_NR_METADATA="/input/genomic/viral/DBs/NCBI_NonHumanViral_nr_May2025/Metadata_NCBI_NonHumanViral_nr_May2025.csv"